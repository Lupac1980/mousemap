<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!-- ============================================================
       Identificação e compatibilidade do sistema operacional
       ============================================================ -->
  <assemblyIdentity version="1.0.0.0" name="MacroRecorder.app"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          requireAdministrator: necessário para que os hooks globais
          (WH_KEYBOARD_LL / WH_MOUSE_LL) e o SendInput funcionem também
          sobre janelas elevadas (Gerenciador de Tarefas, UAC, jogos etc.).

          Se preferir rodar sem admin, troque para "asInvoker", mas nesse
          caso a automação NÃO funcionará sobre aplicações elevadas.
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- DPI Awareness: coordenadas corretas em telas com escala != 100% -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
    </windowsSettings>
  </application>

</assembly>

<Application x:Class="MacroRecorder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode="OnExplicitShutdown": fechar a janela NÃO derruba o app,
        pois ele continua vivo na bandeja do sistema. O encerramento real é
        disparado pelo menu "Sair" do ícone da bandeja (App.Shutdown()).

        StartupUri removido de propósito: a MainWindow é criada em App.xaml.cs
        para podermos injetar os serviços (hooks/hotkeys) antes de exibir.
    -->
    <Application.Resources>

        <!-- ============ PALETA / ESTILOS GLOBAIS (visual moderno) ============ -->
        <SolidColorBrush x:Key="BgBrush"        Color="#1E1E2E"/>
        <SolidColorBrush x:Key="PanelBrush"     Color="#27273A"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#7C4DFF"/>
        <SolidColorBrush x:Key="SuccessBrush"   Color="#4CAF50"/>
        <SolidColorBrush x:Key="DangerBrush"    Color="#E53935"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#ECECEC"/>
        <SolidColorBrush x:Key="MutedBrush"     Color="#8A8AA0"/>

        <!-- Botão padrão arredondado -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox escuro -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

    </Application.Resources>
</Application>
